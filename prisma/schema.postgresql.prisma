datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model AdminUser {
  id           String    @id @default(uuid())
  username     String    @unique
  passwordHash String
  role         String    @default("CASHIER")
  vouchers     Voucher[]
  createdAt    DateTime  @default(now())
}

model Voucher {
  id          String       @id @default(uuid())
  code        String       @unique
  amount      Int          @default(30000)
  isUsed      Boolean      @default(false)
  usedAt      DateTime?
  expiresAt   DateTime
  createdById String
  createdBy   AdminUser    @relation(fields: [createdById], references: [id])
  transaction Transaction?
  createdAt   DateTime     @default(now())
}

model Booth {
  id             String    @id @default(uuid())
  name           String    @default("Booth Utama")
  sessionTimeout Int       @default(90)
  cameraDeviceId String?
  sessions       Session[]
  isActive       Boolean   @default(true)
}

model Session {
  id            String          @id @default(uuid())
  boothId       String
  booth         Booth           @relation(fields: [boothId], references: [id])
  status        String          @default("AWAITING_PAYMENT")
  transaction   Transaction?
  photoShots    PhotoShot[]
  customization PhotoComposite?
  printJobs     PrintJob[]
  startedAt     DateTime        @default(now())
  completedAt   DateTime?
}

model Transaction {
  id        String    @id @default(uuid())
  sessionId String    @unique
  session   Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  method    String
  amount    Int
  status    String    @default("PENDING")
  voucherId String?   @unique
  voucher   Voucher?  @relation(fields: [voucherId], references: [id])
  qrisRef   String?
  paidAt    DateTime?
  createdAt DateTime  @default(now())
}

model FrameTemplate {
  id          String           @id @default(uuid())
  name        String
  layoutType  String
  slotsCount  Int              @default(3)
  aspectRatio String           @default("2:3")
  overlaySvg  String?
  composites  PhotoComposite[]
  isActive    Boolean          @default(true)
}

model PhotoShot {
  id         String   @id @default(uuid())
  sessionId  String
  session    Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  poseIndex  Int
  filePath   String
  capturedAt DateTime @default(now())
}

model PhotoComposite {
  id              String        @id @default(uuid())
  sessionId       String        @unique
  session         Session       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  frameTemplateId String
  frameTemplate   FrameTemplate @relation(fields: [frameTemplateId], references: [id])
  filterSelected  String        @default("NORMAL")
  frameColor      String        @default("#FFFFFF")
  stickersData    String?
  finalImagePath  String
  qrDownloadToken String        @unique @default(cuid())
  createdAt       DateTime      @default(now())
}

model PrintJob {
  id        String   @id @default(uuid())
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  copies    Int      @default(1)
  status    String   @default("QUEUED")
  createdAt DateTime @default(now())
}
